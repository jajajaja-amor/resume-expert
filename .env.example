# 大模型 / Agent 配置（复制为 .env.local 后填写）
# 未配置 LLM_API_KEY 时自动使用 Demo / Mock Agent

# 服务端密钥：切勿写入前端代码、README 或 Git 仓库
LLM_API_KEY=

# OpenAI 兼容接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_PROVIDER=deepseek

# 可选：强制使用 Mock（即使有 API Key）
# USE_MOCK_AI=true

# ===== 扣子工作流（合同合规审查，仅服务端）=====
# 将个人访问密钥放在 .env.local 或云环境 Secrets，切勿提交到仓库
COZE_PAT=
COZE_WORKFLOW_ID=7673528525253820442
COZE_API_BASE=https://api.coze.cn
# 可选：强制使用本地演示结果
# COZE_FORCE_MOCK=true
